From 26adbe116eeffe0422c0ebf3dfd6dfc20ada673a Mon Sep 17 00:00:00 2001
From: Aro design patches <noreply@example.com>
Date: Sat, 17 Oct 2026 08:21:15 +0000
Subject: [PATCH 1/5] composer: single glow definition, static focus, no
 pulsing box-shadow

---
 apps/desktop/src/aro/host-theme.css | 143 ++++------------------------
 1 file changed, 16 insertions(+), 127 deletions(-)

diff --git a/apps/desktop/src/aro/host-theme.css b/apps/desktop/src/aro/host-theme.css
index 077f8f95..129e01a5 100644
--- a/apps/desktop/src/aro/host-theme.css
+++ b/apps/desktop/src/aro/host-theme.css
@@ -473,42 +473,10 @@
 
 @property --shimmer-angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }
 @keyframes shimmerSpin { to { --shimmer-angle: 360deg; } }
-@keyframes glowPulse {
-  0%, 100% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--aro-cyan) 26%, transparent), 0 0 16px -6px color-mix(in srgb, var(--aro-cyan) 40%, transparent); }
-  50% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--aro-cyan) 45%, transparent), 0 0 26px -4px color-mix(in srgb, var(--aro-cyan) 60%, transparent); }
-}
-
+/* The composer frame, beam and state ladder are defined ONCE, in the
+   "Aro composer frame" block further down. Only min-height lives here. */
 :root[data-aro-ui='true'] [data-slot='composer-surface'] {
-  position: relative;
   min-height: 96px;
-  border: 1px solid var(--aro-line);
-  border-radius: 20px;
-  background: var(--aro-overlay);
-  box-shadow: 0 3px 12px -5px rgba(0, 0, 0, 0.55);
-  transition: border-color 160ms ease, box-shadow 160ms ease;
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface']::before {
-  content: "";
-  position: absolute;
-  inset: -1px;
-  border-radius: inherit;
-  padding: 1.3px;
-  background: conic-gradient(from var(--shimmer-angle),
-    transparent 0deg,
-    color-mix(in srgb, var(--aro-iris-soft) 90%, transparent) 46deg,
-    color-mix(in srgb, var(--aro-cyan) 95%, transparent) 80deg,
-    transparent 122deg, transparent 198deg,
-    color-mix(in srgb, var(--aro-iris-soft) 65%, transparent) 238deg,
-    transparent 302deg);
-  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
-  -webkit-mask-composite: xor;
-  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
-  mask-composite: exclude;
-  opacity: 0;
-  pointer-events: none;
-  z-index: 4;
-  transition: opacity 240ms ease;
 }
 
 :root[data-aro-ui='true'] [data-slot='composer-fade'] {
@@ -518,57 +486,6 @@
   background: transparent;
 }
 
-:root[data-aro-ui='true'] [data-slot='composer-surface']:focus-within {
-  border-color: color-mix(in srgb, var(--aro-iris) 50%, var(--aro-line));
-  box-shadow: 0 0 0 1px color-mix(in srgb, var(--aro-iris) 45%, transparent), 0 0 24px -2px color-mix(in srgb, var(--aro-iris) 38%, transparent);
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface']:focus-within::before {
-  opacity: 0.85;
-  animation: shimmerSpin 3.2s linear infinite;
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface'][data-aro-listening]::before,
-:root[data-aro-ui='true'] [data-slot='composer-surface'].is-listening::before {
-  opacity: 1;
-  animation: shimmerSpin 2.4s linear infinite;
-  background: conic-gradient(from var(--shimmer-angle),
-    transparent 0deg,
-    color-mix(in srgb, var(--aro-rose) 90%, transparent) 52deg,
-    transparent 116deg, transparent 208deg,
-    color-mix(in srgb, var(--aro-rose) 70%, transparent) 258deg,
-    transparent 322deg);
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface'][data-aro-listening],
-:root[data-aro-ui='true'] [data-slot='composer-surface'].is-listening {
-  border-color: color-mix(in srgb, var(--aro-rose) 55%, var(--aro-line));
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface'][data-aro-streaming]::before,
-:root[data-aro-ui='true'] [data-slot='composer-surface'].is-streaming::before {
-  opacity: 1;
-  animation: shimmerSpin 1.5s linear infinite;
-  background: conic-gradient(from var(--shimmer-angle),
-    transparent 0deg,
-    color-mix(in srgb, var(--aro-cyan) 95%, transparent) 48deg,
-    color-mix(in srgb, var(--aro-iris-soft) 85%, transparent) 82deg,
-    transparent 124deg, transparent 200deg,
-    color-mix(in srgb, var(--aro-cyan) 70%, transparent) 240deg,
-    transparent 304deg);
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface'][data-aro-streaming],
-:root[data-aro-ui='true'] [data-slot='composer-surface'].is-streaming {
-  border-color: color-mix(in srgb, var(--aro-cyan) 45%, var(--aro-line));
-  animation: glowPulse 2.2s ease-in-out infinite;
-}
-
-:root[data-aro-ui='true'] [data-slot='composer-surface'][data-aro-streaming]:focus-within,
-:root[data-aro-ui='true'] [data-slot='composer-surface'].is-streaming:focus-within {
-  border-color: color-mix(in srgb, var(--aro-cyan) 55%, var(--aro-line));
-}
-
 :root[data-aro-ui='true'] [data-slot='composer-surface'] [contenteditable='true'] {
   /* Prototype .reference-composer-input: min-height 66px (was 58px). */
   min-height: 66px;
@@ -1088,28 +1005,15 @@
   color: currentColor;
 }
 
-/* ── Aro reference-composer glow ──────────────────────────────────────
-   Ported from prototype globals.css `.reference-composer`. The codex grid
-   IS the composer surface (editor above, footer rail below); the outer
-   Hermes composer-surface goes chromeless so exactly ONE frame shows.
-   State layering matches the prototype:
-     :focus-within           → iris ring + iris bloom + iris→cyan beam (3.2s)
-     [data-aro-listening]    → rose ring + rose beam (2.4s)
-     [data-aro-streaming]    → cyan ring + cyan pulse + hot beam (1.5s)   */
-@keyframes aro-glow-pulse {
-  0%,
-  100% {
-    box-shadow:
-      0 0 0 1px color-mix(in srgb, var(--aro-cyan) 26%, transparent),
-      0 0 16px -6px color-mix(in srgb, var(--aro-cyan) 40%, transparent);
-  }
-  50% {
-    box-shadow:
-      0 0 0 1px color-mix(in srgb, var(--aro-cyan) 45%, transparent),
-      0 0 26px -4px color-mix(in srgb, var(--aro-cyan) 60%, transparent);
-  }
-}
-
+/* ── Aro composer frame (single definition) ───────────────────────────
+   The codex grid IS the composer surface (editor above, footer rail below).
+   Calm state ladder, at most ONE moving thing at a time:
+     rest                  hairline + composer shadow (see role block below)
+     :focus-within         static focus ring (role block below); no beam, no bloom
+     [data-aro-listening]  rose border + slow rose beam
+     [data-aro-streaming]  cyan border + cyan beam
+   No blurred glow and no animated box-shadow: a blur that pulses forever
+   repaints every frame and reads as noise around the input. */
 /* Aro composer frame matching prototype .reference-composer */
 :root[data-aro-ui='true'] [data-slot='composer-surface'] {
   position: relative;
@@ -1155,15 +1059,7 @@
 }
 
 :root[data-aro-ui='true'] [data-aro-composer-layout='codex']:focus-within {
-  border-color: color-mix(in srgb, var(--aro-iris) 50%, var(--aro-line));
-  box-shadow:
-    0 0 0 1px color-mix(in srgb, var(--aro-iris) 40%, transparent),
-    0 8px 30px -10px color-mix(in srgb, var(--aro-iris) 55%, transparent);
-}
-
-:root[data-aro-ui='true'] [data-aro-composer-layout='codex']:focus-within::before {
-  opacity: 0.85;
-  animation: shimmerSpin 3.2s linear infinite;
+  border-color: color-mix(in srgb, var(--aro-iris) 55%, var(--aro-line));
 }
 
 /* Dictation live: rose beam, faster. */
@@ -1173,7 +1069,7 @@
 
 :root[data-aro-ui='true'] [data-aro-composer-layout='codex'][data-aro-listening]::before {
   opacity: 1;
-  animation: shimmerSpin 2.4s linear infinite;
+  animation: shimmerSpin 3s linear infinite;
   background: conic-gradient(
     from var(--shimmer-angle),
     transparent 0deg,
@@ -1185,15 +1081,14 @@
   );
 }
 
-/* Turn streaming: cyan pulse + hot beam, fastest. */
+/* Turn streaming: cyan border; the beam is the only motion. */
 :root[data-aro-ui='true'] [data-aro-composer-layout='codex'][data-aro-streaming] {
   border-color: color-mix(in srgb, var(--aro-cyan) 45%, var(--aro-line));
-  animation: aro-glow-pulse 2.2s ease-in-out infinite;
 }
 
 :root[data-aro-ui='true'] [data-aro-composer-layout='codex'][data-aro-streaming]::before {
   opacity: 1;
-  animation: shimmerSpin 1.5s linear infinite;
+  animation: shimmerSpin 2.2s linear infinite;
   background: conic-gradient(
     from var(--shimmer-angle),
     transparent 0deg,
@@ -1210,19 +1105,13 @@
   border-color: color-mix(in srgb, var(--aro-cyan) 55%, var(--aro-line));
 }
 
-/* Reduced motion: the states stay legible (border + glow) without the spin. */
+/* Reduced motion: the states stay legible (border + static beam) without the spin. */
 @media (prefers-reduced-motion: reduce) {
-  :root[data-aro-ui='true'] [data-aro-composer-layout='codex']::before,
-  :root[data-aro-ui='true'] [data-aro-composer-layout='codex']:focus-within::before,
   :root[data-aro-ui='true'] [data-aro-composer-layout='codex'][data-aro-listening]::before,
   :root[data-aro-ui='true'] [data-aro-composer-layout='codex'][data-aro-streaming]::before {
     animation: none;
     opacity: 0.9;
   }
-
-  :root[data-aro-ui='true'] [data-aro-composer-layout='codex'][data-aro-streaming] {
-    animation: none;
-  }
 }
 
