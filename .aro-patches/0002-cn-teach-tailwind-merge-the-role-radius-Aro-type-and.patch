From e7c977b29ede3881203cc4d6feb832561fae80a2 Mon Sep 17 00:00:00 2001
From: Aro design patches <noreply@example.com>
Date: Sat, 17 Oct 2026 08:22:43 +0000
Subject: [PATCH 2/5] cn: teach tailwind-merge the role radius, Aro type and
 shadow keys

---
 apps/desktop/src/lib/utils.test.ts | 34 ++++++++++++++++++++++++++++++
 apps/desktop/src/lib/utils.ts      | 17 ++++++++++++++-
 2 files changed, 50 insertions(+), 1 deletion(-)
 create mode 100644 apps/desktop/src/lib/utils.test.ts

diff --git a/apps/desktop/src/lib/utils.test.ts b/apps/desktop/src/lib/utils.test.ts
new file mode 100644
index 00000000..dc77fb78
--- /dev/null
+++ b/apps/desktop/src/lib/utils.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from 'vitest'
+
+import { cn } from './utils'
+
+describe('cn (tailwind-merge with Aro theme keys)', () => {
+  it('lets a later role radius replace an earlier one', () => {
+    expect(cn('rounded-control', 'rounded-panel')).toBe('rounded-panel')
+    expect(cn('rounded-panel', 'rounded-overlay')).toBe('rounded-overlay')
+  })
+
+  it('lets rounded-full and rounded-none override a role radius', () => {
+    expect(cn('rounded-control', 'rounded-full')).toBe('rounded-full')
+    expect(cn('rounded-panel', 'rounded-none')).toBe('rounded-none')
+  })
+
+  it('treats side variants per side', () => {
+    expect(cn('rounded-t-control', 'rounded-t-panel', 'rounded-b-control')).toBe('rounded-t-panel rounded-b-control')
+  })
+
+  it('keeps an Aro size class next to a text color class (either order)', () => {
+    expect(cn('text-aro-xs', 'text-muted-foreground')).toBe('text-aro-xs text-muted-foreground')
+    expect(cn('text-muted-foreground', 'text-aro-xs')).toBe('text-muted-foreground text-aro-xs')
+  })
+
+  it('lets a later size replace an earlier one, including stock sizes', () => {
+    expect(cn('text-aro-xs', 'text-aro-sm')).toBe('text-aro-sm')
+    expect(cn('text-sm', 'text-aro-xs')).toBe('text-aro-xs')
+  })
+
+  it('merges Aro shadows as shadows, not shadow colors', () => {
+    expect(cn('shadow-aro-e1', 'shadow-aro-e3')).toBe('shadow-aro-e3')
+    expect(cn('shadow-nous', 'shadow-none')).toBe('shadow-none')
+  })
+})
diff --git a/apps/desktop/src/lib/utils.ts b/apps/desktop/src/lib/utils.ts
index d32b0fe6..28f320f4 100644
--- a/apps/desktop/src/lib/utils.ts
+++ b/apps/desktop/src/lib/utils.ts
@@ -1,5 +1,20 @@
 import { type ClassValue, clsx } from 'clsx'
-import { twMerge } from 'tailwind-merge'
+import { extendTailwindMerge } from 'tailwind-merge'
+
+// tailwind-merge only knows Tailwind's built-in scales. Without these theme
+// extensions it treats `rounded-control` as unrelated to `rounded-md` /
+// `rounded-full`, and treats `text-aro-xs` as a text COLOR, so a following
+// `text-muted-foreground` silently deletes the size. Keep in sync with the
+// `--radius-*`, `--text-aro-*` and `--shadow-*` keys in styles.css / tokens.css.
+const twMerge = extendTailwindMerge({
+  extend: {
+    theme: {
+      radius: ['control', 'panel', 'overlay'],
+      text: ['aro-xs', 'aro-sm', 'aro-md', 'aro-lg', 'aro-xl', 'aro-mono'],
+      shadow: ['nous', 'composer', 'menu', 'panel', 'aro-e1', 'aro-e2', 'aro-e3', 'aro-e4']
+    }
+  }
+})
 
 export function cn(...inputs: ClassValue[]) {
   return twMerge(clsx(inputs))
